{
  "manifest_version": 2,
  "name": "G1DM — Internet Download Manager Firefox Companion",
  "version": "4.0.0",
  "description": "Official companion extension for G1DM Next-Generation Download Manager in Mozilla Firefox.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "nativeMessaging",
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "g1dm-companion@g1dm.app",
      "strict_min_version": "91.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://127.0.0.1/*",
        "*://localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "yt-bridge.js"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "G1DM Download Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
