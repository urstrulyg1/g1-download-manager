{
  "name": "g1dm",
  "version": "1.0.0",
  "description": "G1DM — Next-Generation Production-Grade Internet Download Manager",
  "main": "dist/main/index.js",
  "homepage": "./",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "next dev src/renderer",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "next build src/renderer",
    "electron": "electron dist/main/index.js",
    "electron:dev": "wait-on tcp:3000 && electron dist/main/index.js",
    "start": "npm run build && npm run electron",
    "test": "jest",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration",
    "test:e2e": "playwright test test/e2e",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate/run.js",
    "cli": "node dist/main/cli/index.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.8",
    "follow-redirects": "^1.15.6",
    "form-data": "^4.0.0",
    "ftp": "^0.3.10",
    "https-proxy-agent": "^7.0.4",
    "keytar": "^7.9.0",
    "mime-types": "^2.1.35",
    "node-cron": "^3.0.3",
    "socks-proxy-agent": "^8.0.3",
    "winston": "^3.13.0",
    "ws": "^8.17.0",
    "yazl": "^2.5.1",
    "yauzl": "^3.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/better-sqlite3": "^7.6.10",
    "@types/ftp": "^0.3.36",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@types/yazl": "^2.4.5",
    "@types/yauzl": "^2.10.3",
    "concurrently": "^8.2.2",
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "next": "^14.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.g1dm.app",
    "productName": "G1DM",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  }
}
