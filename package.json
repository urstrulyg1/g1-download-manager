{
  "name": "g1dm",
  "version": "1.0.0",
  "description": "G1DM — Next-Generation Production-Grade Internet Download Manager",
  "main": "dist/main/index.js",
  "bin": {
    "g1dm": "dist/main/cli/index.js"
  },
  "homepage": "./",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsc -p tsconfig.main.json --watch",
    "dev:frontend": "next dev src/renderer -p 8055",
    "generate:icons": "node scripts/build/generate-extension-icons.js",
    "validate:extensions": "node scripts/build/validate-extensions.js",
    "build": "npm run generate:icons && npm run validate:extensions && npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p tsconfig.main.json",
    "build:frontend": "next build src/renderer",
    "server": "node dist/main/server.js",
    "start": "node dist/main/server.js",
    "cli": "node dist/main/cli/index.js",
    "test": "jest --runInBand --forceExit",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "ws": "^8.17.0",
    "mime-types": "^2.1.35",
    "yauzl": "^3.1.3",
    "archiver": "^7.0.1",
    "https-proxy-agent": "^7.0.4",
    "socks-proxy-agent": "^8.0.3",
    "lucide-react": "^0.395.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@types/yauzl": "^2.10.3",
    "@types/archiver": "^6.0.2",
    "@types/sql.js": "^1.4.9",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "next": "^14.2.4",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "ts-jest": "^29.1.4",
    "@types/jest": "^29.5.12",
    "typescript": "^5.4.5"
  }
}
