{
  "name": "g1dm",
  "version": "1.0.0",
  "description": "G1DM — Next-Generation Production-Grade Internet Download Manager",
  "main": "dist/main/index.js",
  "bin": {
    "g1dm": "dist/main/cli/index.js"
  },
  "homepage": "./",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsc -p tsconfig.main.json --watch",
    "dev:frontend": "next dev src/renderer -p 8055",
    "generate:icons": "node scripts/build/generate-extension-icons.js",
    "validate:extensions": "node scripts/build/validate-extensions.js",
    "build": "npm run generate:icons && npm run validate:extensions && npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p tsconfig.main.json",
    "build:frontend": "next build src/renderer",
    "server": "node dist/main/server.js",
    "start": "node dist/main/server.js",
    "cli": "node dist/main/cli/index.js",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --forceExit --coverage",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "basic-ftp": "^5.3.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "https-proxy-agent": "^7.0.6",
    "lucide-react": "^0.395.0",
    "mime-types": "^2.1.35",
    "socks-proxy-agent": "^8.0.5",
    "sql.js": "^1.12.0",
    "ws": "^8.18.0",
    "yauzl": "^3.1.3"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.5.14",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jest": "^29.7.0",
    "next": "^15.5.23",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "^8.5.3",
    "sharp": "^0.35.3"
  }
}
